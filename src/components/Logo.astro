---
// Placeholder wordmark. TODO(client): replace with the Deotto Lab logo (SVG) when supplied.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<span class:list={['logo', className]}>
  <svg class="logo-mark" viewBox="0 0 36 36" aria-hidden="true">
    <rect width="36" height="36" rx="9" />
    <path class="logo-drop" d="M18 7.5c3.9 5.3 6.8 8.7 6.8 12.8a6.8 6.8 0 0 1-13.6 0c0-4.1 2.9-7.5 6.8-12.8Z" />
    <path class="logo-line" d="M12.2 21.2c1.9-1.2 3.9-1.2 5.8 0s3.9 1.2 5.8 0" />
  </svg>
  <span class="logo-word"><strong>Deotto</strong> Lab</span>
</span>

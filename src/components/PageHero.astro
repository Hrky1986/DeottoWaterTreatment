---
// Dark title band for inner pages: breadcrumbs, eyebrow, title, lede, and optional extras (badges, buttons).
// With a photo it becomes a full-bleed image header.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  eyebrow?: string;
  lede?: string;
  crumbs?: { label: string; href?: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
}
const { lang, title, eyebrow, lede, crumbs = [], image, imageAlt = '' } = Astro.props;
const t = ui[lang];
---
<section class:list={['page-hero', { 'has-photo': image }]}>
  {image && (
    <Picture class="page-hero-photo" src={image} alt={imageAlt} formats={['avif', 'webp']}
      widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  )}
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label={t.breadcrumb}>
        <ol>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    <div class="page-hero-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="page-hero-lede">{lede}</p>}
      <slot />
    </div>
  </div>
</section>

---
// Reference card: title, location, facility, one key figure and the scope tags.
// The whole card is clickable through the title link (stretched over the card).
import { Picture } from 'astro:assets';
import { ui, type Lang } from '../i18n/ui';
import { link, refName, uploadedImage, type Reference } from '../lib/site';

interface Props { lang: Lang; reference: Reference; industryName?: string; headingLevel?: 'h2' | 'h3' }
const { lang, reference: r, industryName, headingLevel: H = 'h3' } = Astro.props;
const t = ui[lang];
const photo = uploadedImage(r.data.image);
---
<article class="ref-card" data-industry={r.data.industry} data-services={r.data.services.join(' ')}>
  {photo && (
    <Picture class="ref-photo" src={photo} alt="" formats={['avif', 'webp']} widths={[400, 800]}
      sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw" />
  )}
  <div class="ref-body">
    <p class="ref-meta">
      {industryName && <span>{industryName}</span>}
      <span>{r.data.location}</span>
    </p>
    <H class="ref-title"><a href={link(lang, 'references', r.slug)}>{refName(r)}</a></H>
    <p class="ref-facility">{r.data.facility}</p>
    <div class="ref-figure">
      <span class="label">{t.references.keyFigure}</span>
      <strong>{r.data.keyFigure}</strong>
    </div>
    <ul class="tags" aria-label={t.references.scopeTags}>
      {r.data.scope.map((s) => <li>{s}</li>)}
    </ul>
    <span class="ref-more" aria-hidden="true">{t.viewProject} <span class="arrow">→</span></span>
  </div>
</article>

---
// Line icons for the industries. Unknown slugs (new industries added in the CMS) get a water drop.
interface Props { slug: string }
const { slug } = Astro.props;
const paths: Record<string, string> = {
  'data-centers': 'M5 4h14v5H5zM5 10h14v5H5zM5 16h14v4H5zM8 6.5h.01M8 12.5h.01M8 18h.01M12 6.5h4M12 12.5h4',
  'food-beverage': 'M8 3h8M9 3v4l-3 4v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-9l-3-4V3M6 13h12',
  'power-plants': 'M13 2 5 13h6l-1 9 8-11h-6l1-9Z',
  'iron-manufacturing': 'M3 21V11l5 3V11l5 3V7l3-4h3v18ZM7 18h2M12 18h2M17 18h1',
  'commercial-hvac': 'M4 21V5l8-3v19M12 9h8v12M7 8h2M7 12h2M7 16h2M15 13h2M15 17h2M2 21h20',
};
const d = paths[slug] ?? 'M12 3c3.5 4.8 6 7.8 6 11.2a6 6 0 0 1-12 0C6 10.8 8.5 7.8 12 3Z';
---
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={d} /></svg>

---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import { content, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const other: Lang = lang === 'hr' ? 'en' : 'hr';
const site = Astro.site!;
const url = (l: Lang) => new URL(`/${l}/`, site).href;

const fmt = new Intl.NumberFormat(lang === 'hr' ? 'hr-HR' : 'en-GB');
const rows = t.hero.rows.map((r) => {
  const scale = Math.max(r.value, r.limit) * 1.25;
  return { ...r, over: r.value > r.limit, fill: (r.value / scale) * 100, mark: (r.limit / scale) * 100 };
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${t.hero.name}, ${t.hero.role}`,
  description: t.meta.description,
  url: url(lang),
  email: t.contact.email,
  telephone: t.contact.phone,
  areaServed: 'HR',
  inLanguage: lang,
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="hr" href={url('hr')} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={lang === 'hr' ? 'hr_HR' : 'en_GB'} />
    <meta name="theme-color" content="#0f3a43" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <header class="site-header">
      <div class="bar wrap">
        <a class="brand" href={`/${lang}/`}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3c5 7 9 11.5 9 17a9 9 0 0 1-18 0c0-5.5 4-10 9-17Z" /><path class="brand-line" d="M8.5 20h15" /></svg>
          <span><strong>{t.hero.name}</strong><span class="brand-role">{t.hero.role}</span></span>
        </a>
        <a class="lang" href={`/${other}/`} hreflang={other} lang={other} data-lang={other} aria-label={`${t.langSwitch.label}: ${t.langSwitch.otherName}`}>
          <span class="lang-current" aria-hidden="true">{lang.toUpperCase()}</span>
          <span class="lang-other" aria-hidden="true">{t.langSwitch.other}</span>
        </a>
        <nav class="nav" aria-label={lang === 'hr' ? 'Glavna navigacija' : 'Main navigation'}>
          <a href="#problemi">{t.nav.problems}</a>
          <a href="#usluge">{t.nav.services}</a>
          <a href="#postupak">{t.nav.process}</a>
          <a href="#propisi">{t.nav.rules}</a>
          <a href="#pitanja">{t.nav.faq}</a>
          <a href="#kontakt" class="nav-cta">{t.nav.contact}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap hero-grid">
          <div class="hero-copy">
            <h1>{t.hero.headline}</h1>
            <p class="lede">{t.hero.lede}</p>
            <div class="actions">
              <a class="btn btn-light" href="#kontakt">{t.hero.ctaPrimary}</a>
              <a class="btn btn-ghost" href="#problemi">{t.hero.ctaSecondary}</a>
            </div>
          </div>

          <figure class="sheet" aria-labelledby="sheet-title">
            <figcaption>
              <span id="sheet-title" class="sheet-title">{t.hero.sheetTitle}</span>
              <span class="sheet-source">{t.hero.sheetSource}</span>
            </figcaption>
            <ul class="readings">
              {rows.map((r) => (
                <li class:list={['reading', { over: r.over }]}>
                  <div class="reading-head">
                    <span class="reading-name">{r.name}</span>
                    <span class="reading-value">{fmt.format(r.value)} <small>{r.unit}</small></span>
                  </div>
                  <div class="gauge" style={`--fill:${r.fill}%;--mark:${r.mark}%`} role="img"
                    aria-label={`${r.name}: ${fmt.format(r.value)} ${r.unit}, ${t.hero.sheetLimit} ${fmt.format(r.limit)} ${r.unit}, ${r.over ? t.hero.sheetOver : t.hero.sheetOk}`}>
                    <span class="gauge-fill"></span>
                    <span class="gauge-mark"></span>
                  </div>
                  <div class="reading-foot" aria-hidden="true">
                    <span class="status">{r.over ? t.hero.sheetOver : t.hero.sheetOk}</span>
                    <span>{t.hero.sheetLimit} {fmt.format(r.limit)}</span>
                  </div>
                </li>
              ))}
            </ul>
            <p class="sheet-note">{t.hero.sheetNote}</p>
          </figure>
        </div>
      </section>

      <section id="problemi" class="section finder-section" aria-labelledby="problemi-h">
        <div class="wrap">
          <div class="section-head">
            <h2 id="problemi-h">{t.problems.heading}</h2>
            <p>{t.problems.intro}</p>
          </div>

          <div class="finder" data-finder>
            <div class="finder-tabs" role="tablist" aria-orientation="vertical" aria-labelledby="problemi-h" hidden>
              {t.problems.items.map((p, i) => (
                <button type="button" role="tab" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{p.label}</button>
              ))}
            </div>

            <div class="finder-panels">
              {t.problems.items.map((p) => (
                <article class="panel" id={`panel-${p.id}`} role="tabpanel" aria-labelledby={`tab-${p.id}`} tabindex="0">
                  <p class="panel-symptom">{p.label}</p>
                  <h3>{p.title}</h3>
                  <dl class="panel-facts">
                    <div>
                      <dt>{t.problems.causeLabel}</dt>
                      <dd>{p.cause}</dd>
                    </div>
                    <div class="fact-limit">
                      <dt>{t.problems.limitLabel}</dt>
                      <dd>{p.limit}</dd>
                    </div>
                    <div>
                      <dt>{t.problems.fixesLabel}</dt>
                      <dd><ul class="ticks">{p.fixes.map((f) => <li>{f}</li>)}</ul></dd>
                    </div>
                  </dl>
                  <div class="panel-help">
                    <h4>{t.problems.helpLabel}</h4>
                    <p>{p.help}</p>
                    <a class="text-link" href="#kontakt">{t.hero.ctaPrimary}</a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="usluge" class="section" aria-labelledby="usluge-h">
        <div class="wrap">
          <div class="section-head">
            <h2 id="usluge-h">{t.services.heading}</h2>
            <p>{t.services.intro}</p>
          </div>
          <div class="services">
            {t.services.groups.map((g) => (
              <section class="service">
                <h3>{g.title}</h3>
                <p class="service-who">{g.who}</p>
                <ul class="ticks">{g.items.map((it) => <li>{it}</li>)}</ul>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section id="postupak" class="section section-tint" aria-labelledby="postupak-h">
        <div class="wrap">
          <div class="section-head">
            <h2 id="postupak-h">{t.process.heading}</h2>
            <p>{t.process.intro}</p>
          </div>
          <ol class="steps">
            {t.process.steps.map((s) => (
              <li class="step">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="propisi" class="section" aria-labelledby="propisi-h">
        <div class="wrap">
          <div class="section-head">
            <h2 id="propisi-h">{t.rules.heading}</h2>
            <p>{t.rules.intro}</p>
          </div>
          <div class="rules">
            <div class="table-scroll" tabindex="0" role="region" aria-label={t.rules.tableCaption}>
              <table>
                <caption>{t.rules.tableCaption}</caption>
                <thead><tr>{t.rules.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
                <tbody>
                  {t.rules.rows.map(([p, l, w]) => (
                    <tr><th scope="row">{p}</th><td class="num">{l}</td><td>{w}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="timeline-wrap">
              <h3>{t.rules.timelineHeading}</h3>
              <ol class="timeline">
                {t.rules.timeline.map((e) => (
                  <li><span class="tl-date">{e.date}</span><span>{e.text}</span></li>
                ))}
              </ol>
              <h3 class="sources-h">{t.rules.sourcesHeading}</h3>
              <ul class="sources">
                {t.rules.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section id="pitanja" class="section section-tint" aria-labelledby="pitanja-h">
        <div class="wrap faq-grid">
          <h2 id="pitanja-h">{t.faq.heading}</h2>
          <div class="faq">
            {t.faq.items.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="kontakt" class="contact" aria-labelledby="kontakt-h">
        <div class="wrap contact-grid">
          <div>
            <h2 id="kontakt-h">{t.contact.heading}</h2>
            <p>{t.contact.text}</p>
            <ul class="ticks">{t.contact.checklist.map((c) => <li>{c}</li>)}</ul>
          </div>
          <div class="contact-card">
            <dl>
              <div><dt>{t.contact.emailLabel}</dt><dd><a href={`mailto:${t.contact.email}`}>{t.contact.email}</a></dd></div>
              <div><dt>{t.contact.phoneLabel}</dt><dd><a href={`tel:${t.contact.phone.replace(/\s/g, '')}`}>{t.contact.phone}</a></dd></div>
              <div><dt>{t.contact.areaLabel}</dt><dd>{t.contact.area}</dd></div>
            </dl>
            <a class="btn btn-light" href={`mailto:${t.contact.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`}>{t.contact.cta}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-row">
        <p>© {new Date().getFullYear()} {t.hero.name}</p>
        <p>{t.footer.note}</p>
      </div>
    </footer>

    <script>
      // Remember a manual language choice; the edge function and the root page read it.
      document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) =>
        a.addEventListener('click', () => {
          const l = a.dataset.lang!;
          document.cookie = `lang=${l}; path=/; max-age=31536000; SameSite=Lax`;
          try { localStorage.setItem('lang', l); } catch {}
        }),
      );

      // Problem finder: without JS every panel is shown in sequence; with JS it becomes tabs.
      const finder = document.querySelector<HTMLElement>('[data-finder]');
      if (finder) {
        const list = finder.querySelector<HTMLElement>('[role=tablist]')!;
        const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role=tab]')];
        const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
        const select = (i: number, focus = false) => {
          tabs.forEach((t, j) => {
            const on = i === j;
            t.setAttribute('aria-selected', String(on));
            t.tabIndex = on ? 0 : -1;
            panels[j].hidden = !on;
          });
          if (focus) tabs[i].focus();
        };
        list.hidden = false;
        finder.classList.add('is-tabs');
        const fromHash = tabs.findIndex((t) => `#${t.getAttribute('aria-controls')}` === location.hash);
        select(fromHash >= 0 ? fromHash : 0);
        const stacked = matchMedia('(max-width: 51.99rem)');
        tabs.forEach((t, i) =>
          t.addEventListener('click', () => {
            select(i);
            // On phones the panel sits below the buttons, so bring the answer into view.
            if (stacked.matches) panels[i].scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
          }),
        );
        list.addEventListener('keydown', (e) => {
          const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
          if (i < 0) return;
          const n = tabs.length;
          const next = { ArrowDown: i + 1, ArrowRight: i + 1, ArrowUp: i - 1, ArrowLeft: i - 1, Home: 0, End: n - 1 }[e.key];
          if (next === undefined) return;
          e.preventDefault();
          select((next + n) % n, true);
        });
      }
    </script>
  </body>
</html>

---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import fontLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { Picture } from 'astro:assets';
// Hero background is generated by scripts/render-water.mjs.
import heroPhoto from '../assets/water-ripples.jpg';
import { content, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const other: Lang = lang === 'hr' ? 'en' : 'hr';
const site = Astro.site!;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = (l: Lang) => `${base}${l}/`;
const url = (l: Lang) => new URL(path(l), site).href;
const ogImage = new URL(`${base}og-image.jpg`, site).href;


const nav = [
  { href: '#usluge', label: t.nav.services },
  { href: '#postupak', label: t.nav.process },
  { href: '#propisi', label: t.nav.rules },
  { href: '#pitanja', label: t.nav.faq },
];

// Structured data: who Ivan is, what he offers, and the FAQ.
const orgId = `${new URL(base, site).href}#business`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${url(lang)}#webpage`,
      url: url(lang),
      name: t.meta.title,
      description: t.meta.description,
      inLanguage: lang,
      about: { '@id': orgId },
      primaryImageOfPage: ogImage,
    },
    {
      '@type': 'ProfessionalService',
      '@id': orgId,
      name: `${t.hero.name}, ${t.hero.role}`,
      description: t.meta.description,
      url: url(lang),
      image: ogImage,
      email: t.contact.email,
      telephone: t.contact.phone,
      areaServed: { '@type': 'Country', name: 'Croatia' },
      founder: { '@type': 'Person', name: t.hero.name, jobTitle: t.hero.role },
      knowsAbout: t.rules.rows.map(([p]) => p),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: t.services.heading,
        itemListElement: t.services.groups.map((g) => ({
          '@type': 'OfferCatalog',
          name: g.title,
          itemListElement: g.items.map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
        })),
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${url(lang)}#faq`,
      inLanguage: lang,
      mainEntity: t.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={t.hero.name} />
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="hr" href={url('hr')} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="x-default" href={url('en')} />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.hero.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={lang === 'hr' ? 'hr_HR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'hr' ? 'en_GB' : 'hr_HR'} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href={`${base}sitemap.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <header class="site-header">
      <div class="bar wrap">
        <a class="brand" href={path(lang)}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3c5 7 9 11.5 9 17a9 9 0 0 1-18 0c0-5.5 4-10 9-17Z" /><path class="brand-line" d="M8.5 20h15" /></svg>
          <span><strong>{t.hero.name}</strong><span class="brand-role">{t.hero.role}</span></span>
        </a>

        <nav class="nav" id="site-nav" aria-label={t.menu.label}>
          <ul>
            {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            <li><a href="#kontakt" class="nav-cta">{t.nav.contact}</a></li>
          </ul>
        </nav>

        <a class="lang" href={path(other)} hreflang={other} lang={other} data-lang={other} aria-label={`${t.langSwitch.label}: ${t.langSwitch.otherName}`}>
          <span class="lang-current" aria-hidden="true">{lang.toUpperCase()}</span>
          <span class="lang-other" aria-hidden="true">{t.langSwitch.other}</span>
        </a>

        <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav"
          data-open={t.menu.open} data-close={t.menu.close} aria-label={t.menu.open} hidden>
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <Picture class="hero-photo" src={heroPhoto} alt="" formats={['avif', 'webp']}
          widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={55} />
        <div class="wrap">
          <div class="hero-copy">
            <h1>{t.hero.headline}</h1>
            <p class="lede">{t.hero.lede}</p>
            <div class="actions">
              <a class="btn btn-primary" href="#kontakt">{t.hero.ctaPrimary}</a>
            </div>
          </div>
        </div>
      </section>

      <section id="usluge" class="section" aria-labelledby="usluge-h">
        <div class="wrap">
          <div class="section-head">
            <h2 id="usluge-h">{t.services.heading}</h2>
            <p>{t.services.intro}</p>
          </div>
          <div class="services">
            {t.services.groups.map((g) => (
              <section class="service">
                <h3>{g.title}</h3>
                <p class="service-who">{g.who}</p>
                <ul class="ticks">{g.items.map((it) => <li>{it}</li>)}</ul>
              </section>
            ))}
          </div>
        </div>
      </section>

      <section id="postupak" class="section section-mint" aria-labelledby="postupak-h">
        <div class="wrap">
          <div class="section-head">
            <h2 id="postupak-h">{t.process.heading}</h2>
            <p>{t.process.intro}</p>
          </div>
          <ol class="steps">
            {t.process.steps.map((s) => (
              <li class="step">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="propisi" class="section" aria-labelledby="propisi-h">
        <div class="wrap">
          <div class="section-head">
            <h2 id="propisi-h">{t.rules.heading}</h2>
            <p>{t.rules.intro}</p>
          </div>
          <div class="rules">
            <div class="table-scroll" tabindex="0" role="region" aria-label={t.rules.tableCaption}>
              <table>
                <caption>{t.rules.tableCaption}</caption>
                <thead><tr>{t.rules.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
                <tbody>
                  {t.rules.rows.map(([p, l, w]) => (
                    <tr><th scope="row">{p}</th><td class="num">{l}</td><td>{w}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="timeline-wrap">
              <h3>{t.rules.timelineHeading}</h3>
              <ol class="timeline">
                {t.rules.timeline.map((e) => (
                  <li><span class="tl-date">{e.date}</span><span>{e.text}</span></li>
                ))}
              </ol>
              <h3 class="sources-h">{t.rules.sourcesHeading}</h3>
              <ul class="sources">
                {t.rules.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section id="pitanja" class="section section-sky" aria-labelledby="pitanja-h">
        <div class="wrap faq-grid">
          <h2 id="pitanja-h">{t.faq.heading}</h2>
          <div class="faq">
            {t.faq.items.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="kontakt" class="contact" aria-labelledby="kontakt-h">
        <div class="wrap contact-grid">
          <div>
            <h2 id="kontakt-h">{t.contact.heading}</h2>
            <p>{t.contact.text}</p>
            <ul class="ticks">{t.contact.checklist.map((c) => <li>{c}</li>)}</ul>
          </div>
          <div class="contact-card">
            <dl>
              <div><dt>{t.contact.emailLabel}</dt><dd><a href={`mailto:${t.contact.email}`}>{t.contact.email}</a></dd></div>
              <div><dt>{t.contact.phoneLabel}</dt><dd><a href={`tel:${t.contact.phone.replace(/\s/g, '')}`}>{t.contact.phone}</a></dd></div>
              <div><dt>{t.contact.areaLabel}</dt><dd>{t.contact.area}</dd></div>
            </dl>
            <a class="btn btn-primary" href={`mailto:${t.contact.email}?subject=${encodeURIComponent(t.contact.mailSubject)}`}>{t.contact.cta}</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer-row">
        <p>© {new Date().getFullYear()} {t.hero.name}, {t.hero.role}</p>
        <p>{t.footer.note}</p>
      </div>
    </footer>

    <script>
      // Remember a manual language choice; the edge function and the root page read it.
      document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) =>
        a.addEventListener('click', () => {
          const l = a.dataset.lang!;
          // Scope to the site's base path: on github.io the origin is shared with other projects.
          const basePath = a.pathname.slice(0, -(l.length + 1));
          document.cookie = `lang=${l}; path=${basePath}; max-age=31536000; SameSite=Lax`;
          try { localStorage.setItem('deotto-lang', l); } catch {}
        }),
      );

      // Hamburger menu. Without JS the button stays hidden and the links are always shown.
      const burger = document.querySelector<HTMLButtonElement>('.burger');
      const header = document.querySelector<HTMLElement>('.site-header');
      if (burger && header) {
        const nav = document.getElementById('site-nav')!;
        const setOpen = (open: boolean) => {
          burger.setAttribute('aria-expanded', String(open));
          burger.setAttribute('aria-label', open ? burger.dataset.close! : burger.dataset.open!);
          header.classList.toggle('menu-open', open);
        };
        header.classList.add('has-burger');
        burger.hidden = false;
        burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
        nav.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && header.classList.contains('menu-open')) { setOpen(false); burger.focus(); }
        });
        document.addEventListener('click', (e) => { if (!header.contains(e.target as Node)) setOpen(false); });
        matchMedia('(min-width: 68rem)').addEventListener('change', () => setOpen(false));
      }
    </script>
  </body>
</html>

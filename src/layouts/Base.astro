---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import fontLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Logo from '../components/Logo.astro';
import { company } from '../data/company';
import { base, home, langs, locales, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path below the language folder, e.g. 'privacy'. */
  path?: string;
  noindex?: boolean;
}
const { lang, title, description, path = '', noindex = false } = Astro.props;
const t = ui[lang];
const site = Astro.site!;
const abs = (l: Lang) => new URL(`${home(l)}${path ? `${path}/` : ''}`, site).href;
const ogImage = new URL(`${base}og-image.jpg`, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: company.name,
  legalName: company.legalName,
  url: abs(lang),
  image: ogImage,
  email: company.email,
  telephone: company.phone,
  address: { '@type': 'PostalAddress', streetAddress: company.street, postalCode: company.postcode, addressLocality: company.city, addressCountry: company.countryCode },
  areaServed: ['Sweden', 'Norway', 'France', 'Croatia'].map((name) => ({ '@type': 'Country', name })),
  knowsAbout: ['Data center water treatment', 'Liquid cooling flushing', 'CHW passivation', 'Commissioning water treatment', 'BSRIA BG29/2021', 'ASHRAE'],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={abs(lang)} />}
    {!noindex && langs.length > 1 && langs.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locales[lang].og} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#eef3f5" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <header class="site-header">
      <a class="brand" href={home(lang)} aria-label={company.name}><Logo /></a>

      <button class="burger" type="button" aria-expanded="false" aria-controls="site-menu"
        data-open={t.menu.open} data-close={t.menu.close} aria-label={t.menu.open} hidden>
        <span></span><span></span>
      </button>

      <!-- Without JS the links show inline in the header; with JS they open as a full-screen menu. -->
      <nav class="menu" id="site-menu" aria-label={t.menu.label}>
        <ol class="menu-links">
          {t.menu.links.map((l, i) => (
            <li style={`--i: ${i}`}>
              <a href={`${home(lang)}#${l.id}`}><span class="menu-num">{String(i + 1).padStart(2, '0')}</span>{l.label}</a>
            </li>
          ))}
        </ol>
        <p class="menu-foot"><a href={`mailto:${company.email}`}>{company.email}</a></p>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <p>
        {company.legalName} · {company.street}, {company.postcode} {company.city}, {company.country} ·
        OIB {company.oib} · {company.register} · {company.capital} · IBAN {company.iban}, {company.bank} · {company.board}
      </p>
      <p>
        <a href={`mailto:${company.email}`}>{company.email}</a>
        <span aria-hidden="true">·</span>
        <a href={`${home(lang)}privacy/`}>{t.footer.privacy}</a>
        <span aria-hidden="true">·</span>
        © {new Date().getFullYear()}
      </p>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('.site-header')!;
      const onScroll = () => header.classList.toggle('scrolled', scrollY > 40);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Hamburger: a full-screen menu. Escape or a link click closes it; focus returns to the button.
      const burger = header.querySelector<HTMLButtonElement>('.burger')!;
      const menu = document.getElementById('site-menu')!;
      const setOpen = (open: boolean) => {
        burger.setAttribute('aria-expanded', String(open));
        burger.setAttribute('aria-label', open ? burger.dataset.close! : burger.dataset.open!);
        header.classList.toggle('menu-open', open);
        document.documentElement.classList.toggle('no-scroll', open);
        menu.inert = !open;
        document.querySelectorAll<HTMLElement>('main, footer').forEach((el) => { el.inert = open; });
        if (open) menu.querySelector('a')?.focus({ preventScroll: true });
      };
      header.classList.add('has-burger');
      burger.hidden = false;
      menu.inert = true;
      burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
      menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header.classList.contains('menu-open')) { setOpen(false); burger.focus(); }
      });

      // Let things surface slowly as they scroll into view.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -10% 0px' });
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>

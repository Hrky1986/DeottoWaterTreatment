---
// Fallback for "/" when the site is served without the edge function
// (local preview, GitHub Pages, any static host). On Cloudflare Pages,
// functions/index.js answers "/" first with a server redirect.
import { base, defaultLang, langs } from '../i18n/ui';

const site = Astro.site!;
const target = `${base}${defaultLang}/`;
---
<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Deotto Lab</title>
    <link rel="canonical" href={new URL(target, site).href} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline define:vars={{ base, langs, defaultLang }}>
      (function () {
        var lang = null;
        var m = document.cookie.match(/(?:^|; )lang=([a-z]{2})/);
        if (m && langs.indexOf(m[1]) !== -1) lang = m[1];
        location.replace(base + (lang || defaultLang) + '/' + location.hash);
      })();
    </script>
  </head>
  <body>
    <p><a href={target}>Deotto Lab</a></p>
  </body>
</html>

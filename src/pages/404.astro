---
import Base from '../layouts/Base.astro';
import { defaultLang, home, ui } from '../i18n/ui';

const lang = defaultLang;
const t = ui[lang].notFound;
---
<Base lang={lang} title={t.title} description={t.heading} noindex>
  <section class="block lost">
    <h1><em>{t.heading}</em></h1>
    <a class="quiet-link" href={home(lang)}>{t.back} <span aria-hidden="true">→</span></a>
  </section>
</Base>

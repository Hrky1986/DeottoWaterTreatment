---
import Base from '../../../layouts/Base.astro';
import ContactBand from '../../../components/ContactBand.astro';
import PageHero from '../../../components/PageHero.astro';
import { ui, type Lang } from '../../../i18n/ui';
import { getServices, langPaths, link } from '../../../lib/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const services = await getServices(lang);
const crumbs = [{ label: t.nav.home, href: link(lang) }, { label: t.nav.services }];
---
<Base lang={lang} title={t.services.title} description={t.services.description} path={['services']} breadcrumbs={crumbs}
  jsonLd={[{ '@type': 'ItemList', itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.data.title, url: new URL(link(lang, 'services', s.slug), Astro.site).href })) }]}>
  <PageHero lang={lang} title={t.services.heading} lede={t.services.lede} crumbs={crumbs}>
    <ul class="badges badges-dark" aria-label={t.standardsLabel}><li>BSRIA BG29/2021</li><li>ASHRAE</li></ul>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <ol class="service-list">
        {services.map((s, i) => (
          <li class="service-row" data-reveal>
            <span class="tile-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h2><a href={link(lang, 'services', s.slug)}>{s.data.title}</a></h2>
              <p>{s.data.intro}</p>
            </div>
            <ul class="mini-list">
              {s.data.included.slice(0, 3).map((x) => <li>{x}</li>)}
            </ul>
            <span class="tile-arrow" aria-hidden="true">→</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ContactBand lang={lang} />
</Base>

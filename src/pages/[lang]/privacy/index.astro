---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import { ui, type Lang } from '../../../i18n/ui';
import { getPage, langPaths, link } from '../../../lib/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const page = await getPage(lang, 'privacy');
const { Content } = await render(page);
const crumbs = [{ label: t.nav.home, href: link(lang) }, { label: page.data.title }];
---
<Base lang={lang} title={`${page.data.title} – Deotto Lab`} description={page.data.description} path={['privacy']} breadcrumbs={crumbs}>
  <PageHero lang={lang} title={page.data.title} lede={page.data.lede} crumbs={crumbs} />
  <section class="section">
    <div class="wrap"><div class="prose"><Content /></div></div>
  </section>
</Base>

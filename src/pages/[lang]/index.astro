---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
// Generated by scripts/render-water.mjs.
import water from '../../assets/water-ripples.jpg';
import { company } from '../../data/company';
import { base, home, langs, ui, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const c = t.contact;
// Cloudflare Turnstile spam check, only when a site key is configured (see README).
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <section class="hero">
    <Picture class="hero-water" src={water} alt="" formats={['avif', 'webp']}
      widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={50} />
    <svg class="rings" viewBox="0 0 800 800" aria-hidden="true">
      {[0, 1, 2, 3, 4].map((i) => <circle cx="400" cy="400" r="380" style={`animation-delay: ${-i * 2.4}s`} />)}
    </svg>
    <div class="hero-inner">
      <h1>{t.hero.headline[0]}<br /><em>{t.hero.headline[1]}</em></h1>
      <p class="hero-lede">{t.hero.lede}</p>
      <a class="quiet-link" href="#contact">{t.hero.cta} <span aria-hidden="true">→</span></a>
    </div>
    <a class="scroll-cue" href="#services" aria-label={t.hero.scroll}><span></span></a>
  </section>

  <section id="services" class="block" aria-labelledby="services-h">
    <h2 id="services-h" class="kicker" data-reveal>{t.services.heading}</h2>
    <ol class="work">
      {t.services.items.map((w, i) => (
        <li data-reveal style={`--d: ${i * 60}ms`}>
          <span class="work-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="work-title">{w.title}</span>
          <span class="work-note">{w.note}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="about" class="block where" aria-labelledby="about-h">
    <h2 id="about-h" class="kicker" data-reveal>{t.about.heading}</h2>
    <p class="about-text" data-reveal>{t.about.text}</p>
    <p class="places" data-reveal>
      {t.about.places.map((p, i) => <><span class="place">{p}{i < t.about.places.length - 1 && <span class="dot" aria-hidden="true"> ·</span>}</span>{' '}</>)}
    </p>
    <p class="where-note" data-reveal>{t.about.note}</p>
  </section>

  <section id="contact" class="block contact" aria-labelledby="contact-h">
    <div class="contact-head" data-reveal>
      <h2 id="contact-h">{c.heading}</h2>
      <p>{c.lede}</p>
    </div>

    <!-- Shown after a submission without JavaScript (the server redirects to #sent). -->
    <p id="sent" class="sent-note" role="status">{c.sent}</p>

    <form class="form" method="post" action={`${base}api/contact`} data-form novalidate data-reveal>
      <input type="hidden" name="lang" value={lang} />
      <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

      <div class="field">
        <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="120" placeholder=" " />
        <label for="f-name">{c.name}</label>
        <p class="field-error" id="f-name-err" hidden>{c.required}</p>
      </div>
      <div class="field">
        <input id="f-company" name="company" type="text" autocomplete="organization" maxlength="160" placeholder=" " />
        <label for="f-company">{c.company}</label>
      </div>
      <div class="field field-wide">
        <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="200" placeholder=" " />
        <label for="f-email">{c.email}</label>
        <p class="field-error" id="f-email-err" hidden>{c.required}</p>
      </div>
      <div class="field field-wide">
        <textarea id="f-message" name="message" rows="4" required maxlength="5000" placeholder=" "></textarea>
        <label for="f-message">{c.message}</label>
        <p class="field-error" id="f-message-err" hidden>{c.required}</p>
      </div>
      <div class="field-check field-wide">
        <input id="f-consent" name="consent" type="checkbox" value="yes" required />
        <label for="f-consent">{c.consent} <a href={`${home(lang)}privacy/`}>{c.consentLink}</a>.</label>
        <p class="field-error" id="f-consent-err" hidden>{c.required}</p>
      </div>

      {turnstileKey && <div class="cf-turnstile field-wide" data-sitekey={turnstileKey} data-theme="dark"></div>}

      <div class="form-foot field-wide">
        <button class="send" type="submit" data-label={c.submit} data-sending={c.sending}>{c.submit} <span aria-hidden="true">→</span></button>
        <div class="form-status" aria-live="polite" data-status></div>
      </div>
      <template data-sent>{c.sent}</template>
      <template data-error>{c.error} <a href={`mailto:${company.email}`}>{company.email}</a>.</template>
    </form>
  </section>
</Base>

{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  // Inline validation and an in-page submit. Without JS the form posts normally.
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];

    const check = (el: (typeof fields)[number]) => {
      const ok = el.checkValidity();
      el.setAttribute('aria-invalid', String(!ok));
      const err = document.getElementById(`${el.id}-err`);
      if (err) {
        err.hidden = ok;
        if (ok) el.removeAttribute('aria-describedby'); else el.setAttribute('aria-describedby', err.id);
      }
      return ok;
    };
    fields.forEach((el) => {
      el.addEventListener('blur', () => { if (el.value) check(el); });
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') check(el); });
      el.addEventListener('change', () => check(el));
    });

    const show = (kind: 'sent' | 'error', isError: boolean) => {
      status.replaceChildren(form.querySelector<HTMLTemplateElement>(`template[data-${kind}]`)!.content.cloneNode(true));
      status.classList.toggle('is-error', isError);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = fields.filter((el) => !check(el));
      if (invalid.length) { invalid[0].focus(); return; }

      button.disabled = true;
      button.textContent = button.dataset.sending!;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        fields.forEach((el) => el.removeAttribute('aria-invalid'));
        show('sent', false);
      } catch {
        show('error', true);
      } finally {
        button.disabled = false;
        button.innerHTML = `${button.dataset.label} <span aria-hidden="true">→</span>`;
        (window as any).turnstile?.reset();
      }
    });
  }
</script>

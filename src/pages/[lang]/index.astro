---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactBand from '../../components/ContactBand.astro';
import IndustryIcon from '../../components/IndustryIcon.astro';
import LoopDiagram from '../../components/LoopDiagram.astro';
import RefCard from '../../components/RefCard.astro';
// Generated by scripts/render-water.mjs.
import water from '../../assets/water-ripples.jpg';
import { ui, type Lang } from '../../i18n/ui';
import { getIndustries, getReferences, getServices, industryLink, langPaths, link } from '../../lib/site';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const h = t.home;

const services = await getServices(lang);
const industries = await getIndustries(lang);
const featured = (await getReferences(lang)).filter((r) => r.data.featured).slice(0, 3);
const industryName = Object.fromEntries(industries.map((i) => [i.slug, i.data.title]));
---
<Base lang={lang} title={h.title} description={h.description}>
  <section class="hero">
    <Picture class="hero-photo" src={water} alt="" formats={['avif', 'webp']}
      widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={50} />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{h.eyebrow}</p>
        <h1>{h.headline}</h1>
        <p class="hero-lede">{h.lede}</p>
        <div class="actions">
          <a class="btn btn-bright btn-lg" href={link(lang, 'references')}>{h.primary} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost btn-lg" href={link(lang, 'contact')}>{h.secondary}</a>
        </div>
        <ul class="badges badges-dark" aria-label={t.standardsLabel}>
          <li>BSRIA BG29/2021</li>
          <li>ASHRAE</li>
        </ul>
      </div>
      <div class="hero-visual"><LoopDiagram /></div>
    </div>
  </section>

  <section class="proof" aria-label={h.proofLabel}>
    <div class="wrap">
      <ul class="proof-list">
        {h.proof.map((p) => (
          <li>
            <span class="proof-value">{p.value}<span class="proof-unit">{p.label}</span></span>
            <span class="proof-detail">{p.detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="services-h">
    <div class="wrap">
      <div class="section-head section-head-split" data-reveal>
        <div>
          <p class="eyebrow">{h.servicesEyebrow}</p>
          <h2 id="services-h">{h.servicesHeading}</h2>
        </div>
        <a class="link-arrow" href={link(lang, 'services')}>{t.allServices} <span aria-hidden="true">→</span></a>
      </div>
      <ol class="tiles" data-reveal>
        {services.map((s, i) => (
          <li class="tile">
            <span class="tile-num">{String(i + 1).padStart(2, '0')}</span>
            <h3><a href={link(lang, 'services', s.slug)}>{s.data.title}</a></h3>
            <p>{s.data.intro}</p>
            <span class="tile-arrow" aria-hidden="true">→</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-paper" aria-labelledby="refs-h">
    <div class="wrap">
      <div class="section-head section-head-split" data-reveal>
        <div>
          <p class="eyebrow">{h.referencesEyebrow}</p>
          <h2 id="refs-h">{h.referencesHeading}</h2>
        </div>
        <a class="link-arrow" href={link(lang, 'references')}>{t.allReferences} <span aria-hidden="true">→</span></a>
      </div>
      <div class="ref-grid" data-reveal>
        {featured.map((r) => <RefCard lang={lang} reference={r} industryName={industryName[r.data.industry]} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="industries-h">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{h.industriesEyebrow}</p>
        <h2 id="industries-h">{h.industriesHeading}</h2>
      </div>
      <ul class="industry-strip" data-reveal>
        {industries.map((i) => (
          <li>
            <a href={industryLink(lang, i)} class:list={{ lead: i.data.lead }}>
              <IndustryIcon slug={i.slug} />
              <span>{i.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactBand lang={lang} />
</Base>

---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ContactBand from '../../../components/ContactBand.astro';
import IndustryIcon from '../../../components/IndustryIcon.astro';
import PageHero from '../../../components/PageHero.astro';
import RefCard from '../../../components/RefCard.astro';
import { langs, ui, type Lang } from '../../../i18n/ui';
import { getIndustries, getReferences, industryLink, link } from '../../../lib/site';

export async function getStaticPaths() {
  const paths = [];
  // The lead sector (data centers) has its own page at /data-centers/.
  for (const lang of langs) for (const i of await getIndustries(lang)) if (!i.data.lead) paths.push({ params: { lang, slug: i.slug } });
  return paths;
}

const { lang: l, slug } = Astro.params;
const lang = l as Lang;
const t = ui[lang];
const industries = await getIndustries(lang);
const industry = industries.find((i) => i.slug === slug)!;
const { Content } = await render(industry);
const refs = (await getReferences(lang)).filter((r) => r.data.industry === slug);
const others = industries.filter((i) => i.slug !== slug);
const crumbs = [
  { label: t.nav.home, href: link(lang) },
  { label: t.nav.industries, href: link(lang, 'industries') },
  { label: industry.data.title },
];
---
<Base lang={lang} title={`${industry.data.title} water treatment – Deotto Lab`} description={industry.data.description}
  path={['industries', slug!]} breadcrumbs={crumbs}>
  <PageHero lang={lang} eyebrow={t.nav.industries} title={industry.data.title} lede={industry.data.intro} crumbs={crumbs} />

  <section class="section">
    <div class="wrap detail-grid">
      <div data-reveal>
        <h2 class="h-small">{t.industries.help}</h2>
        <ul class="ticks ticks-lg">{industry.data.help.map((x) => <li>{x}</li>)}</ul>
        <div class="prose"><Content /></div>
      </div>
      <aside class="panel" data-reveal>
        <span class="panel-icon"><IndustryIcon slug={industry.slug} /></span>
        <h2 class="h-small">{t.industries.systems}</h2>
        <ul class="sys-list">{industry.data.systems.map((x) => <li>{x}</li>)}</ul>
      </aside>
    </div>
  </section>

  <section class="section section-paper" aria-labelledby="ind-ref-h">
    <div class="wrap">
      <div class="section-head" data-reveal><h2 id="ind-ref-h">{t.industries.reference}</h2></div>
      {refs.length > 0 ? (
        <div class="ref-grid" data-reveal>{refs.map((r) => <RefCard lang={lang} reference={r} />)}</div>
      ) : (
        <p class="empty-note" data-reveal>{t.industries.noReference} <a href={link(lang, 'contact')}>{t.cta}</a></p>
      )}
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="other-ind-h">
    <div class="wrap">
      <h2 id="other-ind-h" class="h-small">{t.allIndustries}</h2>
      <ul class="chip-links">
        {others.map((i) => <li><a href={industryLink(lang, i)}>{i.data.title}</a></li>)}
      </ul>
    </div>
  </section>

  <ContactBand lang={lang} />
</Base>
